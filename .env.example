# Supabase local — obtené los valores con `npm run db:estado`
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tests de RLS (tests/rls/ayudas.ts). Se generan en .env.test, no en .env,
# con: npx supabase status -o env 2>/dev/null > .env.test
API_URL=
ANON_KEY=
SERVICE_ROLE_KEY=

# Panel web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App móvil (Expo)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
